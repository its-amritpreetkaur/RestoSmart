@model IEnumerable<RestoSmart.Models.RawMaterial>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RestoSmart | Live Inventory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FF6B00;
            --bg-body: #F4F4F5;
            --card-bg: #FFFFFF;
            --text-dark: #000000;
            --border-light: #E4E4E7;
            --danger: #DC2626;
            --success: #10B981;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-dark);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .admin-nav {
            background-color: var(--text-dark);
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dashboard-card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            padding: 30px;
            margin-top: 40px;
        }

        .table > :not(caption) > * > * {
            padding: 1rem 0.5rem;
            vertical-align: middle;
        }

        .stock-healthy {
            color: var(--success);
            font-weight: 800;
        }

        .stock-critical {
            color: var(--danger);
            font-weight: 900;
            background-color: #FEE2E2;
            padding: 4px 12px;
            border-radius: 6px;
        }

        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-healthy {
            background-color: #D1FAE5;
            color: #065F46;
        }

        .badge-warning {
            background-color: #FEE2E2;
            color: #991B1B;
            animation: pulse 2s infinite;
        }

        /* Styling for the new Refill input and button */
        .refill-input {
            width: 80px;
            border: 2px solid var(--border-light);
            border-radius: 6px;
            padding: 4px 8px;
            font-weight: 600;
        }

        .btn-refill {
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 15px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            transition: transform 0.2s, background-color 0.2s;
        }

            .btn-refill:hover {
                background-color: #E66000;
                transform: translateY(-1px);
                color: white;
            }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.4);
            }

            70% {
                box-shadow: 0 0 0 6px rgba(220, 38, 38, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(220, 38, 38, 0);
            }
        }
    </style>
</head>
<body>

    <div class="admin-nav">
        <div style="font-weight: 900; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 1px;">
            Resto<span style="color: var(--primary);">Smart</span> | Backoffice
        </div>
       
    </div>

    <div class="container mb-5">
        <div class="dashboard-card">
            <h4 style="font-weight: 900; margin-bottom: 5px; text-transform: uppercase;">Live Inventory Monitor</h4>
            <p style="color: #71717A; font-weight: 500; margin-bottom: 25px;">Real-time raw material tracking based on kitchen consumption.</p>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead style="border-bottom: 2px solid var(--text-dark);">
                        <tr>
                            <th style="color: #71717A; font-size: 0.85rem; text-transform: uppercase;">Ingredient</th>
                            <th style="color: #71717A; font-size: 0.85rem; text-transform: uppercase;">Current Level</th>
                            <th style="color: #71717A; font-size: 0.85rem; text-transform: uppercase;">Min Reorder</th>
                            <th style="color: #71717A; font-size: 0.85rem; text-transform: uppercase;">Status</th>
                            <th style="color: #71717A; font-size: 0.85rem; text-transform: uppercase; text-align: center;">Refill Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isLowStock = item.CurrentStock <= item.MinReorder;

                            <tr>
                                <td style="font-weight: 700; font-size: 1.1rem;">@item.Name</td>

                                <td>
                                    <span class="@(isLowStock ? "stock-critical" : "stock-healthy")">
                                        @item.CurrentStock.ToString("0.00") @item.Unit
                                    </span>
                                </td>

                                <td style="color: #71717A; font-weight: 600;">@item.MinReorder.ToString("0.00") @item.Unit</td>

                                <td>
                                    @if (isLowStock)
                                    {
                                        <span class="badge-status badge-warning">Restock Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-healthy">Optimal</span>
                                    }
                                </td>

                                <td style="text-align: right;">
                                    <form action="/Home/UpdateStock" method="post" class="d-flex justify-content-end align-items-center gap-2">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="number" step="0.01" name="addQty" class="refill-input" placeholder="+ Qty" required />
                                        <button type="submit" class="btn-refill">Refill</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</body>
</html>