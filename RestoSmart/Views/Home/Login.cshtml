@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RestoSmart | Employee Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FF6B00;
            --bg-body: #F4F4F5;
            --card-bg: #FFFFFF;
            --text-dark: #000000;
            --border-light: #E4E4E7;
        }

        body {
            background-color: var(--text-dark); /* Sleek dark background for the portal */
            color: var(--text-dark);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }

        .brand-logo {
            font-weight: 900;
            font-size: 2rem;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        .brand-accent {
            color: var(--primary);
        }

        .form-control {
            border: 2px solid var(--border-light);
            border-radius: 8px;
            padding: 12px;
            font-weight: 500;
            background-color: #FAFAFA;
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: none;
                background-color: white;
            }

        .form-label {
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            color: #52525B;
        }

        .btn-login {
            background-color: var(--primary);
            color: white;
            border-radius: 8px;
            padding: 14px;
            font-weight: 900;
            border: none;
            text-transform: uppercase;
            width: 100%;
            margin-top: 20px;
            transition: 0.2s;
            letter-spacing: 1px;
        }

            .btn-login:hover {
                background-color: #E55B00;
            }

        .error-message {
            color: #DC2626;
            font-weight: 700;
            font-size: 0.9rem;
            text-align: center;
            margin-bottom: 15px;
            background-color: #FEE2E2;
            padding: 10px;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="brand-logo">
            Resto<span class="brand-accent">Smart</span>
        </div>

        <h6 class="text-center mb-4" style="color: #71717A; font-weight: 600; text-transform: uppercase;">Employee Portal</h6>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <form action="/Home/Login" method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" name="username" required>
            </div>

            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" name="password" required>
            </div>

            <button type="submit" class="btn btn-login">Sign In</button>
        </form>
    </div>

</body>
</html>
