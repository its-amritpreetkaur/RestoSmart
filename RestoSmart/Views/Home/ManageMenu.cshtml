@model IEnumerable<RestoSmart.Models.MenuItem>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RestoSmart | Manage Menu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #F4F4F5;
            font-family: sans-serif;
        }

        .admin-nav {
            background-color: #000;
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            margin-top: 30px;
        }

        .btn-orange {
            background-color: #FF6B00;
            color: white;
            font-weight: bold;
        }

            .btn-orange:hover {
                background-color: #E55B00;
                color: white;
            }
    </style>
</head>
<body>
    <div class="admin-nav">
        <h4 style="font-weight: 900; margin: 0; text-transform: uppercase;">Resto<span style="color: #FF6B00;">Smart</span> | Admin</h4>
        <a href="/Home/Welcome" style="color: white; text-decoration: none; font-weight: 600;">Log Out</a>
    </div>

    <div class="container">
        <div class="table-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 style="font-weight: 800;">Menu Items</h4>
                <a href="/Home/AddDish" class="btn btn-orange">+ Add New Dish</a>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DishId</td>
                            <td><img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" onerror="this.src='https://placehold.co/50x50?text=No+Img'"></td>
                            <td style="font-weight: bold;">@item.Name</td>
                            <td>₹@item.Price</td>
                            <td>
                                <a href="/Home/EditDish/@item.DishId" class="btn btn-sm btn-outline-dark">Edit</a>
                                <form action="/Home/DeleteDish" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.DishId" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this dish?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
