@model RestoSmart.Models.MenuItem
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RestoSmart | Add Menu Item</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FF6B00;
            --bg-body: #F4F4F5;
            --card-bg: #FFFFFF;
            --text-dark: #000000;
            --border-light: #E4E4E7;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-dark);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .admin-nav {
            background-color: var(--text-dark);
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .form-card {
            background: var(--card-bg);
            border: 1px solid var(--border-light);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            padding: 30px;
            margin-top: 40px;
        }

        .form-control, .form-select {
            border: 2px solid var(--border-light);
            border-radius: 8px;
            padding: 12px;
            font-weight: 500;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary);
                box-shadow: none;
            }

        .form-label {
            font-weight: 700;
            color: var(--text-dark);
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .btn-save {
            background-color: var(--primary);
            color: white;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 800;
            border: none;
            text-transform: uppercase;
            width: 100%;
            margin-top: 20px;
            transition: 0.2s;
        }

            .btn-save:hover {
                background-color: #E55B00;
            }

        /* Live Image Preview Styling */
        .image-preview-box {
            width: 100%;
            height: 250px;
            border: 2px dashed var(--border-light);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #FAFAFA;
            overflow: hidden;
            margin-top: 10px;
        }

        #imgPreview {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none; 
        }
    </style>
</head>
<body>

    <div class="admin-nav">
        <div style="font-weight: 900; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 1px;">
            Resto<span style="color: var(--primary);">Smart</span> | Admin
        </div>
        <a href="/Home/Index" style="color: white; text-decoration: none; font-weight: 600;">← Back to Menu</a>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="form-card">
                    <h4 style="font-weight: 900; margin-bottom: 25px; text-transform: uppercase;">Add New Dish</h4>

                    <form action="/Home/AddDish" method="post">

                        <div class="mb-3">
                            <label class="form-label">Dish Name</label>
                            <input type="text" class="form-control" name="Name" placeholder="e.g. Spicy Chicken Tacos" required>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Price (₹)</label>
                                <input type="number" class="form-control" name="Price" placeholder="e.g. 350" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" name="Category" required>
                                    <option value="Starter">Starter</option>
                                    <option value="Main Course">Main Course</option>
                                    <option value="Dessert">Dessert</option>
                                    <option value="Beverage">Beverage</option>
                                </select>
                            </div>
                        </div>

                        <h5 class="mt-4 fw-bold">DISH RECIPE (INVENTORY LINK)</h5>
                        <hr />

                        <div id="ingredient-container">
                            <div class="row g-2 mb-2 ingredient-row">
                                <div class="col-md-7">
                                    <select name="ingredients" class="form-select border-2">
                                        <option value="">-- Select Ingredient --</option>
                                        @foreach (var item in (IEnumerable<RestoSmart.Models.RawMaterial>)ViewBag.Inventory)
                                        {
                                            <option value="@item.Id">@item.Name (@item.Unit)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" step="0.01" name="qtys" class="form-control border-2" placeholder="Qty">
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-danger w-100" onclick="removeRow(this)">✕</button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-dark btn-sm" onclick="addRow()">+ Add Existing</button>
                            <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="modal" data-bs-target="#newIngredientModal">
                                ✨ Create New Ingredient
                            </button>
                        </div>
                        <script>
                                                          function saveNewIngredient() {
                                const nameInput = document.getElementById('newMatName');
                                const stockInput = document.getElementById('newMatStock');
                                const unitInput = document.getElementById('newMatUnit');

                                const data = {
                                    Name: nameInput.value,
                                    CurrentStock: parseFloat(stockInput.value),
                                    Unit: unitInput.value
                                };

                                if (!data.Name || isNaN(data.CurrentStock) || !data.Unit) {
                                    alert("Please fill in all fields correctly.");
                                    return;
                                }

                                fetch('/Home/QuickAddMaterial', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(data)
                                })
                                .then(res => {
                                    if (!res.ok) throw new Error('Server error: ' + res.status);
                                    return res.json();
                                })
                                .then(result => {
                                    if (result.success) {
                                        const modalElement = document.getElementById('newIngredientModal');
                                        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
                                        modalInstance.hide();

                                        const dropdowns = document.querySelectorAll('select[name="ingredients"]');
                                        dropdowns.forEach(select => {
                                            const opt = document.createElement('option');
                                            opt.value = result.id; // The new ID from Oracle
                                            opt.text = data.Name + " (" + data.Unit + ")";
                                            select.add(opt);
                                            if (select === document.activeElement || dropdowns.length === 1) {
                                                select.value = result.id;
                                            }
                                        });

                                        // 3. Reset form
                                        nameInput.value = '';
                                        unitInput.value = '';

                                        alert("Success! " + data.Name + " added to inventory.");
                                    } else {
                                        alert("Error: " + result.message);
                                    }
                                })
                                .catch(err => {
                                    console.error(err);
                                    alert("Check Console (F12): Failed to save ingredient.");
                                });
                            }
                                                        function addRow() {
                                const container = document.getElementById('ingredient-container');
                                const firstRow = document.querySelector('.ingredient-row');
                                const newRow = firstRow.cloneNode(true);
                                newRow.querySelectorAll('input').forEach(i => i.value = ''); // Clear values
                                container.appendChild(newRow);
                            }

                            function removeRow(btn) {
                                const rows = document.querySelectorAll('.ingredient-row');
                                if (rows.length > 1) btn.closest('.ingredient-row').remove();
                            }
                        </script>

                        <div class="mb-3">
                            <label class="form-label">Image Link (URL)</label>
                            <input type="text" class="form-control" id="imageUrlInput" name="ImageUrl" placeholder="Paste image address here..." required>

                            <div class="image-preview-box">
                                <span id="previewText" style="color: #A1A1AA; font-weight: 600;">Image Preview</span>
                                <img id="imgPreview" src="" alt="Dish Preview">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-save">Save to Database</button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('imageUrlInput').addEventListener('input', function() {
            const url = this.value;
            const imgEl = document.getElementById('imgPreview');
            const txtEl = document.getElementById('previewText');

            if (url) {
                imgEl.src = url;
                imgEl.style.display = 'block';
                txtEl.style.display = 'none';
            } else {
                imgEl.src = '';
                imgEl.style.display = 'none';
                txtEl.style.display = 'block';
            }
        });
    </script>
    <div class="modal fade" id="newIngredientModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">CREATE NEW MATERIAL</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ingredient Name</label>
                        <input type="text" id="newMatName" class="form-control" placeholder="e.g. Saffron">
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Initial Stock</label>
                            <input type="number" id="newMatStock" class="form-control" value="10">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Unit (Kg/Ltr)</label>
                            <input type="text" id="newMatUnit" class="form-control" placeholder="Kg">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-dark" onclick="saveNewIngredient()">Add to Inventory</button>
                </div>
            </div>
        </div>
    </div>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
