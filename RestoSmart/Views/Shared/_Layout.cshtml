<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestoSmart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestoSmart.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-uppercase" href="/Home/Index" style="font-weight: 900; letter-spacing: -1px; font-size: 1.4rem; color: aliceblue !important;">
                    Resto<span style="color: #FF6B00;">Smart</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                       
                        
                    </ul>
                    <ul class="navbar-nav">
                        @* We use 'UserRole' here because that is what we set in the Login method *@
                        @{
                            var userRole = Context.Session.GetString("UserRole");
                        }

                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            if (userRole == "Admin" || userRole == "Chef" || userRole == "Staff")
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-uppercase" href="/Home/Inventory">
                                        📦 Live Inventory
                                    </a>
                                </li>
                            }

                            

                            <li class="nav-item">
                                <a class="nav-link fw-bold text-uppercase text-danger" href="/Home/Logout">
                                    Logout
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RestoSmart - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
